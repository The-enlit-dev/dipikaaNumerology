---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NumberRing from '../../islands/reading/NumberRing.tsx';
import { ALL_NUMBERS, NUMBER_MEANINGS, type PositionKey } from '../../data/numbers';
import { PERSONAL_YEARS } from '../../data/cycles';
import { POSITIONS } from '../../data/positions';

export function getStaticPaths() {
  return ALL_NUMBERS.map((n) => ({ params: { number: String(n) } }));
}

const n = Number(Astro.params.number);
const m = NUMBER_MEANINGS[n];
const isMaster = n > 9;
const idx = ALL_NUMBERS.indexOf(n as (typeof ALL_NUMBERS)[number]);
const prev = ALL_NUMBERS[(idx - 1 + ALL_NUMBERS.length) % ALL_NUMBERS.length];
const next = ALL_NUMBERS[(idx + 1) % ALL_NUMBERS.length];
const positionKeys: PositionKey[] = ['lifePath', 'expression', 'soulUrge', 'personality', 'birthday'];
const py = PERSONAL_YEARS[n];

const title = `Number ${n} Meaning in Numerology — ${m.title}`;
const description = `What does the number ${n} mean in numerology? ${m.title}: ${m.keywords.join(', ').toLowerCase()}. Traits, strengths, challenges, relationships, career and growth for ${n} as a Life Path, Expression, Soul Urge and more.`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Number meanings', item: new URL('/meanings/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: `Number ${n}`, item: new URL(`/meanings/${n}/`, Astro.site).href },
    ],
  },
];
---
<BaseLayout title={title} description={description} schema={schema} ogType="article">
  <section class="meaning-hero night stars glow">
    <div class="container hero-grid">
      <div class="stack" style="--stack: var(--space-4)">
        <nav aria-label="Breadcrumb" class="crumbs small"><a href="/meanings/">Number meanings</a> <span aria-hidden="true">/</span> <span aria-current="page">{n}</span></nav>
        <p class="eyebrow">{isMaster ? 'Master number' : 'Number'} {n}</p>
        <h1>{m.title}</h1>
        <ul class="chips">{m.keywords.map((k) => <li class="chip">{k}</li>)}</ul>
        <p class="lede">{m.essence}</p>
      </div>
      <div class="hero-ring"><NumberRing value={n} isMaster={isMaster} size={260} tone="night" caption={isMaster ? `${n}/${n === 11 ? 2 : n === 22 ? 4 : 6}` : undefined} label={`The number ${n}`} /></div>
    </div>
  </section>

  <section class="section paper">
    <div class="container content-grid">
      <article class="main-col stack" style="--stack: var(--space-6)">
        <div>
          <h2 class="h-sm">Character</h2>
          <p class="lede">{m.traits}</p>
        </div>
        <div class="two">
          <div class="box">
            <h3>Strengths</h3>
            <ul class="mark-list plus">{m.strengths.map((s) => <li>{s}</li>)}</ul>
          </div>
          <div class="box">
            <h3>Challenges</h3>
            <ul class="mark-list minus">{m.challenges.map((s) => <li>{s}</li>)}</ul>
          </div>
        </div>
        <div>
          <h2 class="h-sm">Relationships &amp; social life</h2>
          <p>{m.relationships}</p>
        </div>
        <div>
          <h2 class="h-sm">Career &amp; work</h2>
          <p>{m.career}</p>
          <ul class="chips career">{m.careerPaths.map((c) => <li class="chip">{c}</li>)}</ul>
        </div>
        <div>
          <h2 class="h-sm">Personal growth</h2>
          <ul class="mark-list star">{m.growth.map((g) => <li>{g}</li>)}</ul>
        </div>
        <blockquote class="quote">
          <span class="eyebrow">A question to reflect on</span>
          <p>{m.reflection}</p>
        </blockquote>
      </article>

      <aside class="side-col">
        <div class="box sticky">
          <h2 class="h-sm">{n} in your chart</h2>
          <dl class="positions-dl">
            {positionKeys.filter((k) => !(n === 33 && k === 'birthday')).map((k) => (
              <div>
                <dt>As your {POSITIONS[k].name} number</dt>
                <dd>{m.positions[k]}</dd>
              </div>
            ))}
            {py && (
              <div>
                <dt>As a Personal Year</dt>
                <dd><strong>{py.title}.</strong> {py.overview}</dd>
              </div>
            )}
          </dl>
          <a class="btn btn-gold side-cta" href="/calculator/">Find your numbers</a>
        </div>
      </aside>
    </div>
  </section>

  <nav class="section tight paper-deep" aria-label="Other numbers">
    <div class="container pager">
      <a href={`/meanings/${prev}/`} rel="prev"><small>Previous</small><span>{prev} · {NUMBER_MEANINGS[prev].title}</span></a>
      <a href="/meanings/" class="all">All numbers</a>
      <a href={`/meanings/${next}/`} rel="next" class="nx"><small>Next</small><span>{next} · {NUMBER_MEANINGS[next].title}</span></a>
    </div>
    <div class="container"><p class="disclaimer pager-note">Interpretations summarise meanings traditionally associated with each number, offered for reflection and entertainment.</p></div>
  </nav>
</BaseLayout>

<style>
  .meaning-hero { position: relative; overflow: hidden; padding-block: var(--space-8); }
  .hero-grid { display: grid; gap: var(--space-6); align-items: center; }
  @media (min-width: 52em) { .hero-grid { grid-template-columns: 1.3fr 1fr; } }
  .hero-ring { display: grid; place-items: center; }
  .hero-ring :global(svg) { width: min(260px, 60vw); height: auto; }
  .crumbs a { color: var(--gold-300); }
  .crumbs { color: var(--mist-400); }
  .content-grid { display: grid; gap: var(--space-7); }
  @media (min-width: 60em) { .content-grid { grid-template-columns: 1.4fr 1fr; align-items: start; } }
  .h-sm { font-size: var(--step-3); margin-bottom: var(--space-3); }
  .main-col p { color: var(--ink-700); }
  .two { display: grid; gap: var(--space-4); }
  @media (min-width: 40em) { .two { grid-template-columns: 1fr 1fr; } }
  .box { background: #fff; border: 1px solid var(--cream-200); border-radius: var(--radius); padding: var(--space-5); }
  .box h3 { font-size: var(--step-2); margin-bottom: var(--space-3); }
  .career { margin-top: var(--space-4); }
  .quote { margin: 0; padding: var(--space-6); background: var(--night-900); border-radius: var(--radius-lg); }
  .quote .eyebrow { color: var(--gold-400); }
  .quote p { font-family: var(--font-display); font-size: var(--step-2); font-style: italic; color: #fff !important; margin-top: var(--space-3); line-height: 1.3; }
  .sticky { position: sticky; top: 92px; }
  .positions-dl { display: grid; gap: var(--space-4); }
  .positions-dl dt { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-700); }
  .positions-dl dd { margin: var(--space-1) 0 0; font-size: 0.95rem; color: var(--ink-700); }
  .side-cta { margin-top: var(--space-5); width: 100%; }
  .pager { display: grid; gap: var(--space-3); grid-template-columns: 1fr; }
  @media (min-width: 48em) { .pager { grid-template-columns: 1fr auto 1fr; align-items: center; } }
  .pager a { text-decoration: none; display: grid; padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--cream-300); background: #fff; }
  .pager a.all { text-align: center; font-weight: 600; }
  .pager a.nx { text-align: right; }
  .pager small { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-700); }
  .pager span { font-family: var(--font-display); font-size: 1.3rem; }
  .pager-note { margin-top: var(--space-6); }
</style>

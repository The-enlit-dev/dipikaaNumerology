---
/** The Dipikaa mark: a nine-point wheel with a single gold star at its crown. */
interface Props { size?: number; class?: string }
const { size = 36, class: className } = Astro.props;
import { wheelPoint } from '../lib/geometry';
const dots = [1, 2, 3, 4, 5, 6, 7, 8].map((d) => wheelPoint(d, 15, 20, 20));
const top = wheelPoint(9, 15, 20, 20);
---
<svg class={className} width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <circle cx="20" cy="20" r="15" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="0.8" />
  <circle cx="20" cy="20" r="9.5" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="0.6" />
  {dots.map((p) => <circle cx={p.x} cy={p.y} r="1.15" fill="currentColor" />)}
  <path d={`M${top.x} ${top.y - 4.2} L${top.x + 1.2} ${top.y - 1.2} L${top.x + 4.2} ${top.y} L${top.x + 1.2} ${top.y + 1.2} L${top.x} ${top.y + 4.2} L${top.x - 1.2} ${top.y + 1.2} L${top.x - 4.2} ${top.y} L${top.x - 1.2} ${top.y - 1.2} Z`} fill="#c9a45c" />
  <circle cx="20" cy="20" r="1.6" fill="#c9a45c" />
</svg>
